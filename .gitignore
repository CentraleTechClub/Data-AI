# ===== Secrets / environment variables =====
# Real env files are ignored; template/example env files stay tracked.
.env
.env.*
*.env
!*example.env
!*.env.example

# Other common credential/key files
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
*.gguf.json

# ===== Model weights & trained artifacts =====
# These are generated/downloaded by running the notebooks, not source material.
*.pkl
*.pt
*.pth
*.safetensors
*.gguf
*.onnx
*.ckpt
*.pb
pytorch_model.bin
**/model/
**/models/
**/checkpoints/
**/*_weights/

